{
  "name": "schemacase",
  "version": "0.1.0",
  "description": "Every column makes its case: render a data-model spec as one self-contained HTML page, with unexplained columns listed as schema debt.",
  "keywords": [
    "data-model",
    "schema",
    "erd",
    "documentation",
    "database",
    "postgres",
    "prisma",
    "graphviz",
    "schema-review",
    "cli"
  ],
  "homepage": "https://github.com/DrFritzi/schemacase#readme",
  "bugs": {
    "url": "https://github.com/DrFritzi/schemacase/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrFritzi/schemacase.git"
  },
  "license": "MIT",
  "author": "DrFritzi",
  "type": "module",
  "bin": {
    "schemacase": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/render.mjs",
    "./spec": "./src/spec.mjs",
    "./import/postgres": "./src/import/postgres.mjs",
    "./import/prisma": "./src/import/prisma.mjs",
    "./schema.json": "./schema/schemacase.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schema"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "node --test \"test/*.test.mjs\"",
    "quicktest": "pnpm run lint && pnpm test",
    "example": "node src/cli.mjs example/shop.json --proposal example/proposed.json -o example/shop.html"
  },
  "dependencies": {
    "@viz-js/viz": "^3.29.0"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.14.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
