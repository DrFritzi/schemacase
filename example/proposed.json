{
  "$schema": "../schema/schemacase.schema.json",
  "schemacase": 1,
  "title": "Webshop",
  "collectionsLabel": "tables",
  "operationsLabel": "endpoints",
  "fieldNotes": {
    "*.id": {
      "why": "Addresses one row. A uuid, so a client can pick the id before the row exists and retry safely.",
      "usedBy": [
        "SHP-ARC-01"
      ]
    },
    "*.created_at": {
      "why": "When the row appeared: the only audit trail most tables need.",
      "usedBy": [
        "SHP-ARC-02"
      ]
    },
    "*.customer_id": {
      "why": "Whose row this is; every customer-facing query filters on it.",
      "usedBy": [
        "SHP-ARC-03"
      ]
    },
    "*.order_id": {
      "why": "Ties the row to the order it belongs to.",
      "usedBy": [
        "SHP-ORD-01"
      ]
    },
    "orders.status": {
      "why": "Where the order is in its life: placed, paid, shipped or cancelled. The storefront reads it to decide what a customer may still do.",
      "usedBy": [
        "SHP-ORD-03"
      ]
    }
  },
  "collections": [
    {
      "name": "categories",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "key": true,
          "required": true
        },
        {
          "name": "name",
          "type": "text",
          "required": true,
          "why": "The label in the shop's menu.",
          "usedBy": [
            "SHP-CAT-01"
          ]
        }
      ]
    },
    {
      "name": "products",
      "fields": [
        {
          "name": "sku",
          "type": "text",
          "key": true,
          "required": true,
          "why": "The code the till scans. It is the identity the whole shop already uses, so nothing has to translate.",
          "usedBy": [
            "SHP-CAT-02"
          ]
        },
        {
          "name": "title",
          "type": "text",
          "required": true,
          "why": "What a person sees in the list.",
          "usedBy": [
            "SHP-CAT-01"
          ]
        },
        {
          "name": "category_id",
          "type": "uuid",
          "why": "Files the product under a menu entry. Empty while a product is still being set up.",
          "usedBy": [
            "SHP-CAT-01"
          ]
        },
        {
          "name": "cents",
          "type": "integer",
          "required": true,
          "why": "The price in minor units. Integers avoid rounding drift.",
          "usedBy": [
            "SHP-CAT-03"
          ]
        },
        {
          "name": "active",
          "type": "boolean",
          "required": true,
          "why": "Hides a product without deleting the orders that mention it.",
          "usedBy": [
            "SHP-CAT-04"
          ]
        },
        {
          "name": "attributes",
          "type": "jsonb",
          "document": true
        },
        {
          "name": "weight_grams",
          "type": "integer"
        }
      ]
    },
    {
      "name": "stock",
      "fields": [
        {
          "name": "sku",
          "type": "text",
          "key": true,
          "required": true,
          "why": "Which product the count is for.",
          "usedBy": [
            "SHP-CAT-05"
          ]
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": true,
          "why": "What the warehouse says is on the shelf. The shop refuses orders above it.",
          "usedBy": [
            "SHP-CAT-05"
          ]
        },
        {
          "name": "counted_at",
          "type": "timestamptz"
        }
      ]
    },
    {
      "name": "customers",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "key": true,
          "required": true
        },
        {
          "name": "email",
          "type": "text",
          "required": true,
          "why": "How an order confirmation reaches someone.",
          "usedBy": [
            "SHP-CUS-01"
          ]
        },
        {
          "name": "name",
          "type": "text",
          "required": true,
          "why": "What to print on the delivery note.",
          "usedBy": [
            "SHP-CUS-01"
          ]
        },
        {
          "name": "marketing_opt_in",
          "type": "boolean",
          "required": true,
          "why": "Consent has to be recorded to be honoured. Defaults to false.",
          "usedBy": [
            "SHP-CUS-02"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true
        }
      ]
    },
    {
      "name": "addresses",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "key": true,
          "required": true
        },
        {
          "name": "customer_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "line1",
          "type": "text",
          "required": true,
          "why": "Street and number, as the carrier wants them.",
          "usedBy": [
            "SHP-CUS-03"
          ]
        },
        {
          "name": "city",
          "type": "text",
          "required": true,
          "why": "Part of the address the carrier prints.",
          "usedBy": [
            "SHP-CUS-03"
          ]
        },
        {
          "name": "postcode",
          "type": "text",
          "required": true,
          "why": "Part of the address the carrier prints.",
          "usedBy": [
            "SHP-CUS-03"
          ]
        },
        {
          "name": "country",
          "type": "text",
          "required": true,
          "why": "An ISO code. It decides shipping rates and tax.",
          "usedBy": [
            "SHP-CUS-03"
          ]
        },
        {
          "name": "kind",
          "type": "text"
        }
      ]
    },
    {
      "name": "orders",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "key": true,
          "required": true
        },
        {
          "name": "customer_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "ship_to",
          "type": "jsonb",
          "document": true,
          "why": "A copy of the address as it was when the order was placed. Editing an address later must not change where an old order went.",
          "usedBy": [
            "SHP-ORD-02"
          ]
        },
        {
          "name": "status",
          "type": "text",
          "required": true
        },
        {
          "name": "placed_at",
          "type": "timestamptz",
          "required": true,
          "why": "When it was ordered, for the returns window.",
          "usedBy": [
            "SHP-ORD-04"
          ]
        },
        {
          "name": "coupon_code",
          "type": "text"
        }
      ]
    },
    {
      "name": "order_items",
      "fields": [
        {
          "name": "order_id",
          "type": "uuid",
          "key": true,
          "required": true
        },
        {
          "name": "sku",
          "type": "text",
          "key": true,
          "required": true,
          "why": "Which product was bought.",
          "usedBy": [
            "SHP-ORD-01"
          ]
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": true,
          "why": "How many. At least one.",
          "usedBy": [
            "SHP-ORD-01"
          ]
        },
        {
          "name": "unit_cents",
          "type": "integer",
          "required": true,
          "why": "The price at the time of purchase, so a later price change cannot rewrite history.",
          "usedBy": [
            "SHP-ORD-05"
          ]
        }
      ]
    },
    {
      "name": "payments",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "key": true,
          "required": true
        },
        {
          "name": "order_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "provider",
          "type": "text",
          "required": true,
          "why": "Which processor took the money. A refund has to go back the same way.",
          "usedBy": [
            "SHP-PAY-01"
          ]
        },
        {
          "name": "provider_ref",
          "type": "text",
          "required": true,
          "why": "The processor's id for the charge, needed to refund or dispute it.",
          "usedBy": [
            "SHP-PAY-01"
          ]
        },
        {
          "name": "amount_cents",
          "type": "integer",
          "required": true,
          "why": "What was actually charged. It differs from the order after a partial refund.",
          "usedBy": [
            "SHP-PAY-02"
          ]
        },
        {
          "name": "captured_at",
          "type": "timestamptz",
          "why": "Set when the money is really taken. Empty while it is only authorized.",
          "usedBy": [
            "SHP-PAY-02"
          ]
        },
        {
          "name": "raw_response",
          "type": "jsonb",
          "document": true
        }
      ]
    },
    {
      "name": "shipments",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "key": true,
          "required": true
        },
        {
          "name": "order_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "carrier",
          "type": "text",
          "required": true,
          "why": "Which carrier holds the parcel. It picks the tracking page.",
          "usedBy": [
            "SHP-FUL-01"
          ]
        },
        {
          "name": "tracking_no",
          "type": "text",
          "why": "What the customer types into the carrier's page.",
          "usedBy": [
            "SHP-FUL-01"
          ]
        },
        {
          "name": "shipped_at",
          "type": "timestamptz",
          "why": "Starts the delivery clock.",
          "usedBy": [
            "SHP-FUL-02"
          ]
        },
        {
          "name": "label_url",
          "type": "text"
        }
      ]
    }
  ],
  "links": [
    {
      "from": "categories",
      "to": "products",
      "via": "category_id",
      "optional": true
    },
    {
      "from": "products",
      "to": "stock",
      "via": "sku",
      "strong": true
    },
    {
      "from": "customers",
      "to": "addresses",
      "via": "customer_id",
      "strong": true
    },
    {
      "from": "customers",
      "to": "orders",
      "via": "customer_id"
    },
    {
      "from": "orders",
      "to": "order_items",
      "via": "order_id",
      "strong": true
    },
    {
      "from": "products",
      "to": "order_items",
      "via": "sku"
    },
    {
      "from": "orders",
      "to": "payments",
      "via": "order_id"
    },
    {
      "from": "orders",
      "to": "shipments",
      "via": "order_id",
      "strong": true
    }
  ],
  "operations": [
    {
      "name": "list_products",
      "summary": "The products a shopper can see, optionally within one menu entry.",
      "inputs": [
        {
          "name": "category_id",
          "type": "uuid"
        },
        {
          "name": "search",
          "type": "text"
        }
      ]
    },
    {
      "name": "register_customer",
      "summary": "Creates the account and records marketing consent.",
      "inputs": [
        {
          "name": "email",
          "type": "text",
          "required": true
        },
        {
          "name": "name",
          "type": "text",
          "required": true
        },
        {
          "name": "marketing_opt_in",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "place_order",
      "summary": "Turns a basket into an order and asks the card processor to authorize it.",
      "inputs": [
        {
          "name": "customer_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "items",
          "type": "list",
          "required": true
        },
        {
          "name": "shipping_address_id",
          "type": "uuid"
        },
        {
          "name": "coupon_code",
          "type": "text"
        }
      ]
    },
    {
      "name": "list_orders",
      "summary": "A customer's orders, newest first.",
      "inputs": [
        {
          "name": "customer_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "status",
          "type": "text"
        }
      ]
    },
    {
      "name": "cancel_order",
      "summary": "Cancels an order that has not shipped and releases the authorization.",
      "inputs": [
        {
          "name": "order_id",
          "type": "uuid",
          "required": true
        }
      ]
    },
    {
      "name": "capture_payment",
      "summary": "Takes the authorized money once the goods are packed.",
      "inputs": [
        {
          "name": "order_id",
          "type": "uuid",
          "required": true
        }
      ]
    },
    {
      "name": "ship_order",
      "summary": "Books the carrier and stores the tracking number.",
      "inputs": [
        {
          "name": "order_id",
          "type": "uuid",
          "required": true
        },
        {
          "name": "carrier",
          "type": "text"
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "Catalogue",
      "blurb": "What is for sale, and how much is left.",
      "collections": [
        "categories",
        "products",
        "stock"
      ],
      "operations": [
        "list_products"
      ]
    },
    {
      "name": "Customers",
      "blurb": "Who buys, and where things go.",
      "collections": [
        "customers",
        "addresses"
      ],
      "operations": [
        "register_customer"
      ]
    },
    {
      "name": "Orders",
      "blurb": "What was bought.",
      "collections": [
        "orders",
        "order_items"
      ],
      "operations": [
        "place_order",
        "list_orders",
        "cancel_order"
      ]
    },
    {
      "name": "Fulfilment",
      "blurb": "Getting paid and getting it there.",
      "collections": [
        "payments",
        "shipments"
      ],
      "operations": [
        "capture_payment",
        "ship_order"
      ]
    }
  ],
  "systems": [
    {
      "name": "Web shop",
      "kind": "external",
      "blurb": "The storefront in the customer's browser."
    },
    {
      "name": "Card processor",
      "kind": "external",
      "blurb": "Authorizes and captures payments, and calls back when a charge settles."
    },
    {
      "name": "Carrier",
      "kind": "external",
      "blurb": "Prints labels and reports where a parcel is."
    },
    {
      "name": "Warehouse system",
      "kind": "internal",
      "blurb": "Counts stock and packs orders. Reports counts once an hour."
    },
    {
      "name": "Data warehouse",
      "kind": "store",
      "blurb": "The analytics copy of orders, refreshed every night."
    }
  ],
  "flows": [
    {
      "from": "Web shop",
      "to": "Orders",
      "label": "place order"
    },
    {
      "from": "Orders",
      "to": "Card processor",
      "label": "authorize"
    },
    {
      "from": "Card processor",
      "to": "Fulfilment",
      "label": "charge settled"
    },
    {
      "from": "Fulfilment",
      "to": "Carrier",
      "label": "book shipment"
    },
    {
      "from": "Warehouse system",
      "to": "Catalogue",
      "label": "stock counts"
    },
    {
      "from": "Orders",
      "to": "Data warehouse",
      "label": "nightly export"
    }
  ],
  "changes": [
    {
      "id": "P1",
      "title": "Stop storing the order total",
      "why": "It is the sum of the order's items and can drift from them. Nothing records why it is stored.",
      "cost": "Every read of an order sums its items.",
      "affects": {
        "collections": [
          "orders"
        ],
        "fields": [
          "orders.total_cents"
        ]
      }
    },
    {
      "id": "P2",
      "title": "Copy the shipping address onto the order",
      "why": "An address edited later must not change where an old order went.",
      "cost": "Addresses are copied instead of referenced, and open orders need one migration.",
      "affects": {
        "collections": [
          "orders"
        ],
        "fields": [
          "orders.shipping_address_id",
          "orders.ship_to"
        ]
      }
    },
    {
      "id": "P3",
      "title": "Drop the legacy columns",
      "why": "Nothing reads them since the old shop was switched off.",
      "cost": "A one-way change: the old ids cannot be recovered afterwards.",
      "affects": {
        "fields": [
          "customers.legacy_id",
          "orders.legacy_ref"
        ]
      }
    }
  ]
}
